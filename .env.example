# ==========================================
# Variables de entorno del proyecto GameZone
# Unidad 3: Seguridad, Web Services y APIs
# ==========================================

# Puerto de ejecución del servidor Express
PORT=3000

# Clave pública de la API de RAWG Video Games Database
# Puedes obtener una gratuita en: https://rawg.io/apidocs
# Si se deja vacía, el servidor utilizará el modo de fallback con FreeToGame API / catálogo en vivo
RAWG_API_KEY="tu_clave_de_rawg_aqui"

# Entorno de ejecución
NODE_ENV="development"

# GEMINI_API_KEY: Inyectado por la plataforma si es requerido
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL base del servicio
APP_URL="MY_APP_URL"
